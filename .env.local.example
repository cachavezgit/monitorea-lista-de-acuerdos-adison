# Copia este archivo a .env.local y llénalo. .env.local NO se sube a git.
#   cp .env.local.example .env.local

# --- Avisos por WhatsApp (CallMeBot, https://www.callmebot.com) ---
# Tu número con código de país, sin espacios. México: +52 + 10 dígitos
# (si el mensaje de prueba no llega, intenta con +521 + 10 dígitos)
WHATSAPP_TELEFONO=
# La apikey que CallMeBot te manda por WhatsApp al registrarte
WHATSAPP_APIKEY=

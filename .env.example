# Copia este archivo a .env y llénalo. .env NO se sube a git.
#   cp .env.example .env
#
# Expedientes a monitorear en la Lista de Acuerdos de ADISON
# https://adison.stjsonora.gob.mx/Publicacion/ListaAcuerdos/
# Los IDs salen de los <select> del formulario (clic derecho > Inspeccionar).

# Órgano jurisdiccional (value del option). 157 = JUZGADO TERCERO DE PRIMERA INSTANCIA DE LO FAMILIAR DE HERMOSILLO
ADISON_ID_UNIDAD=157

# Ramo (grupo = data-value del option; cat = value, solo para el link). 1/2 = FAMILIAR
ADISON_ID_GRUPO_RAMO=1
ADISON_ID_CAT_RAMO=2

# Tipo asunto (value del option). 1 = EXPEDIENTE
ADISON_ID_TIPO_ASUNTO=1

# Expedientes (asunto/año), separados por coma. Todos de este mismo juzgado y ramo.
# Si alguno lleva BIS agrega su número: asunto/año/bis (1 = BIS, 3 = TER…)
ADISON_EXPEDIENTES=123/2025, 45/2024
